export struct App {
    name: string,
}

export component AppWindow inherits Window {
    title: "Farbig Launcher";
    full-screen: true;
    background: #091428;
    forward-focus: scope;

    callback launch-app(string);
    callback quit();

    in property <[App]> apps;
    in-out property <int> selected-app: 0;
    in-out property <bool> showing-quit-confirmation: false;
    in-out property <bool> quit-confirmed: true;

    scope := FocusScope {
        KeyBinding {
            keys: @keys(Return);
            activated => {
                if (root.showing-quit-confirmation) {
                    if (root.quit-confirmed) {
                        root.quit();
                    } else {
                        root.showing-quit-confirmation = false;
                    }
                } else {
                    root.launch-app(root.apps[root.selected-app].name);
                }
            }
        }

        KeyBinding {
            keys: @keys(LeftArrow);
            activated => {
                if (root.showing-quit-confirmation) {
                    root.quit-confirmed = true;
                } else {
                    root.selected-app = 0;
                }
            }
        }

        KeyBinding {
            keys: @keys(UpArrow);
            activated => {
                if (root.showing-quit-confirmation) {
                    root.quit-confirmed = true;
                } else {
                    root.selected-app = 0;
                }
            }
        }

        KeyBinding {
            keys: @keys(RightArrow);
            activated => {
                if (root.showing-quit-confirmation) {
                    root.quit-confirmed = false;
                } else {
                    root.selected-app = Math.min(root.selected-app + 1, root.apps.length - 1);
                }
            }
        }

        KeyBinding {
            keys: @keys(DownArrow);
            activated => {
                if (root.showing-quit-confirmation) {
                    root.quit-confirmed = false;
                } else {
                    root.selected-app = Math.min(root.selected-app + 1, root.apps.length - 1);
                }
            }
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                if (root.showing-quit-confirmation) {
                    root.showing-quit-confirmation = false;
                } else {
                    root.quit-confirmed = true;
                    root.showing-quit-confirmation = true;
                }
            }
        }

        KeyBinding {
            keys: @keys(Backspace);
            activated => {
                if (root.showing-quit-confirmation) {
                    root.showing-quit-confirmation = false;
                } else {
                    root.quit-confirmed = true;
                    root.showing-quit-confirmation = true;
                }
            }
        }

        Rectangle {
            background: #091428;

            VerticalLayout {
                padding-left: 72px;
                padding-right: 72px;
                padding-top: 64px;
                padding-bottom: 64px;
                spacing: 18px;

                Text {
                    text: "FARBIG";
                    color: #71ddff;
                    font-size: 18px;
                    font-weight: 700;
                }

                Text {
                    text: "Choose an app";
                    color: #f4f8ff;
                    font-size: 42px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: 24px;

                    for app[index] in root.apps : Rectangle {
                    width: 300px;
                    height: 240px;
                    background: root.selected-app == index || app-touch.has-hover ? (index == 0 ? #1e5d7d : #754c83) : (index == 0 ? #164663 : #54375f);
                    border-radius: 8px;
                    border-width: root.selected-app == index ? 4px : 0px;
                    border-color: #d8f4ff;

                    animate background, border-width {
                        duration: 160ms;
                        easing: ease-in-out;
                    }

                    VerticalLayout {
                        padding: 28px;
                        alignment: space-between;

                        Text {
                            text: (index + 1 < 10 ? "0" : "") + (index + 1);
                            color: index == 0 ? #b9ecff : #f0cbff;
                            font-size: 18px;
                        }

                        Text {
                            text: app.name;
                            color: #ffffff;
                            font-size: 30px;
                            font-weight: 700;
                        }
                    }

                    app-touch := TouchArea {
                        clicked => {
                            root.selected-app = index;
                            root.launch-app(app.name);
                        }
                    }
                    }
                }
            }
        }
    }

    if root.showing-quit-confirmation : Rectangle {
        background: #000000a8;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 480px;
            height: 270px;
            background: #14233b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #58708f;

            VerticalLayout {
                padding: 28px;
                spacing: 16px;

                Text {
                    text: "Quit Farbig?";
                    color: #ffffff;
                    font-size: 28px;
                    font-weight: 700;
                }

                Text {
                    text: "Press OK to quit, or Back to continue.";
                    color: #c5d5e9;
                    font-size: 18px;
                }

                HorizontalLayout {
                    spacing: 16px;

                    ok-button := Rectangle {
                        width: 150px;
                        height: 54px;
                        background: root.quit-confirmed || ok-touch.has-hover ? #2cc9f0 : #1b6b85;
                        border-radius: 6px;
                        border-width: root.quit-confirmed ? 3px : 0px;
                        border-color: #e1f9ff;

                        Text {
                            text: "OK";
                            color: #031321;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        ok-touch := TouchArea {
                            clicked => { root.quit(); }
                        }
                    }

                    back-button := Rectangle {
                        width: 150px;
                        height: 54px;
                        background: !root.quit-confirmed || back-touch.has-hover ? #314963 : #22354b;
                        border-radius: 6px;
                        border-width: !root.quit-confirmed ? 3px : 0px;
                        border-color: #e1f9ff;

                        Text {
                            text: "Back";
                            color: #ffffff;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        back-touch := TouchArea {
                            clicked => { root.showing-quit-confirmation = false; }
                        }
                    }
                }
            }
        }
    }
}