export struct App {
    name: string,
    path: string,
    icon: image,
}

export component AppWindow inherits Window {
    title: "Farbig Launcher";
    full-screen: true;
    background: #091428;
    forward-focus: scope;

    callback launch-app(string);
    callback quit();

    in property <[App]> apps;
    in-out property <int> selected-app: -1;
    in-out property <length> app-scroll-y: 0px;
    in-out property <bool> showing-quit-confirmation: false;
    in-out property <bool> quit-confirmed: true;
    in-out property <bool> showing-launch-message: false;
    in-out property <string> launching-app-name: "";
    private property <bool> pending-keyboard-scroll: false;
    private property <length> keyboard-scroll-target: 0px;
    private property <int> grid-columns: 4;
    private property <length> app-width: 300px;
    private property <length> app-height: 240px;
    private property <length> app-gap: 24px;

    animate app-scroll-y {
        duration: root.pending-keyboard-scroll ? 150ms : 0ms;
        easing: ease-out-quint;
    }

    changed app-scroll-y => {
        if (root.pending-keyboard-scroll) {
            if (root.app-scroll-y == root.keyboard-scroll-target) {
                root.pending-keyboard-scroll = false;
            }
        } else {
            root.selected-app = -1;
        }
    }

    scope := FocusScope {
        KeyBinding {
            keys: @keys(Return);
            activated => {
                if (root.showing-quit-confirmation) {
                    if (root.quit-confirmed) {
                        root.quit();
                    } else {
                        root.showing-quit-confirmation = false;
                    }
                } else if (!root.showing-launch-message && root.selected-app >= 0) {
                    root.launching-app-name = root.apps[root.selected-app].name;
                    root.showing-launch-message = true;
                    root.launch-app(root.apps[root.selected-app].path);
                }
            }
        }

        KeyBinding {
            keys: @keys(LeftArrow);
            activated => {
                if (root.showing-quit-confirmation) {
                    root.quit-confirmed = true;
                } else if (!root.showing-launch-message && root.apps.length > 0) {
                    root.selected-app = root.selected-app < 0 ? Math.min(root.apps.length - 1, Math.floor(-root.app-scroll-y / (root.app-height + root.app-gap)) * root.grid-columns) : Math.max(root.selected-app - 1, root.selected-app - Math.mod(root.selected-app, root.grid-columns));
                }
            }
        }

        KeyBinding {
            keys: @keys(UpArrow);
            activated => {
                if (root.showing-quit-confirmation) {
                    root.quit-confirmed = true;
                } else if (!root.showing-launch-message && root.apps.length > 0) {
                    root.selected-app = root.selected-app < 0 ? Math.min(root.apps.length - 1, Math.floor(-root.app-scroll-y / (root.app-height + root.app-gap)) * root.grid-columns) : Math.max(root.selected-app - root.grid-columns, 0);
                    root.keyboard-scroll-target = Math.floor(root.selected-app / root.grid-columns) * (root.app-height + root.app-gap) < -root.app-scroll-y ? -Math.floor(root.selected-app / root.grid-columns) * (root.app-height + root.app-gap) : Math.floor(root.selected-app / root.grid-columns) * (root.app-height + root.app-gap) + root.app-height > -root.app-scroll-y + app-list.height ? -(Math.floor(root.selected-app / root.grid-columns) * (root.app-height + root.app-gap) - (app-list.height - root.app-height)) : root.app-scroll-y;
                    root.pending-keyboard-scroll = root.keyboard-scroll-target != root.app-scroll-y;
                    root.app-scroll-y = root.keyboard-scroll-target;
                }
            }
        }

        KeyBinding {
            keys: @keys(RightArrow);
            activated => {
                if (root.showing-quit-confirmation) {
                    root.quit-confirmed = false;
                } else if (!root.showing-launch-message && root.apps.length > 0) {
                    root.selected-app = root.selected-app < 0 ? Math.min(root.apps.length - 1, Math.floor(-root.app-scroll-y / (root.app-height + root.app-gap)) * root.grid-columns) : Math.min(root.selected-app + 1, Math.min(root.apps.length - 1, root.selected-app - Math.mod(root.selected-app, root.grid-columns) + root.grid-columns - 1));
                }
            }
        }

        KeyBinding {
            keys: @keys(DownArrow);
            activated => {
                if (root.showing-quit-confirmation) {
                    root.quit-confirmed = false;
                } else if (!root.showing-launch-message && root.apps.length > 0) {
                    root.selected-app = root.selected-app < 0 ? Math.min(root.apps.length - 1, Math.floor(-root.app-scroll-y / (root.app-height + root.app-gap)) * root.grid-columns) : Math.min(root.selected-app + root.grid-columns, root.apps.length - 1);
                    root.keyboard-scroll-target = Math.floor(root.selected-app / root.grid-columns) * (root.app-height + root.app-gap) < -root.app-scroll-y ? -Math.floor(root.selected-app / root.grid-columns) * (root.app-height + root.app-gap) : Math.floor(root.selected-app / root.grid-columns) * (root.app-height + root.app-gap) + root.app-height > -root.app-scroll-y + app-list.height ? -(Math.floor(root.selected-app / root.grid-columns) * (root.app-height + root.app-gap) - (app-list.height - root.app-height)) : root.app-scroll-y;
                    root.pending-keyboard-scroll = root.keyboard-scroll-target != root.app-scroll-y;
                    root.app-scroll-y = root.keyboard-scroll-target;
                }
            }
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                if (root.showing-quit-confirmation) {
                    root.showing-quit-confirmation = false;
                } else if (!root.showing-launch-message) {
                    root.quit-confirmed = true;
                    root.showing-quit-confirmation = true;
                }
            }
        }

        KeyBinding {
            keys: @keys(Backspace);
            activated => {
                if (root.showing-quit-confirmation) {
                    root.showing-quit-confirmation = false;
                } else if (!root.showing-launch-message) {
                    root.quit-confirmed = true;
                    root.showing-quit-confirmation = true;
                }
            }
        }

        Rectangle {
            background: #091428;

            VerticalLayout {
                padding-left: 72px;
                padding-right: 72px;
                padding-top: 64px;
                padding-bottom: 64px;
                spacing: 18px;

                Text {
                    text: "FARBIG";
                    color: #71ddff;
                    font-size: 18px;
                    font-weight: 700;
                }

                Text {
                    text: root.selected-app >= 0 ? root.apps[root.selected-app].name : "Choose an app";
                    color: #f4f8ff;
                    font-size: 42px;
                    font-weight: 700;
                }

                app-list := Flickable {
                    content-y <=> root.app-scroll-y;
                    content-width: self.width;
                    content-height: Math.ceil(root.apps.length / root.grid-columns) * (root.app-height + root.app-gap) - root.app-gap;

                    Rectangle {
                    width: parent.width;
                    height: Math.max(parent.height, app-list.content-height);

                    for app[index] in root.apps : Rectangle {
                    x: (app-list.width - root.grid-columns * root.app-width - (root.grid-columns - 1) * root.app-gap) / 2 + Math.mod(index, root.grid-columns) * (root.app-width + root.app-gap);
                    y: Math.floor(index / root.grid-columns) * (root.app-height + root.app-gap);
                    width: root.app-width;
                    height: root.app-height;
                    background: transparent;

                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: 20px;
                        width: 128px;
                        height: 128px;
                        background: transparent;
                        border-radius: 8px;
                        border-width: root.selected-app == index || app-touch.has-hover ? 4px : 0px;
                        border-color: #d8f4ff;

                        animate border-width {
                        duration: 160ms;
                        easing: ease-in-out;
                        }

                        Image {
                            source: app.icon;
                            width: parent.width - 16px;
                            height: parent.height - 16px;
                            x: 8px;
                            y: 8px;
                            image-fit: contain;
                        }
                    }

                    Text {
                        y: 170px;
                        width: parent.width;
                        text: app.name;
                        color: #ffffff;
                        font-size: 25px;
                        font-weight: 500;
                        horizontal-alignment: center;
                    }
                    app-touch := TouchArea {
                        clicked => {
                            if (!root.showing-launch-message) {
                                root.selected-app = index;
                                root.launching-app-name = app.name;
                                root.showing-launch-message = true;
                                root.launch-app(app.path);
                            }
                        }
                    }
                    }
                    }
                }
            }
        }
    }

    if root.showing-quit-confirmation : Rectangle {
        background: #000000a8;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 480px;
            height: 270px;
            background: #14233b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #58708f;

            VerticalLayout {
                padding: 28px;
                spacing: 16px;

                Text {
                    text: "Quit Farbig?";
                    color: #ffffff;
                    font-size: 28px;
                    font-weight: 700;
                }

                Text {
                    text: "Press OK to quit, or Back to continue.";
                    color: #c5d5e9;
                    font-size: 18px;
                }

                HorizontalLayout {
                    spacing: 16px;

                    ok-button := Rectangle {
                        width: 150px;
                        height: 54px;
                        background: root.quit-confirmed || ok-touch.has-hover ? #2cc9f0 : #1b6b85;
                        border-radius: 6px;
                        border-width: root.quit-confirmed ? 3px : 0px;
                        border-color: #e1f9ff;

                        Text {
                            text: "OK";
                            color: #031321;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        ok-touch := TouchArea {
                            clicked => { root.quit(); }
                        }
                    }

                    back-button := Rectangle {
                        width: 150px;
                        height: 54px;
                        background: !root.quit-confirmed || back-touch.has-hover ? #314963 : #22354b;
                        border-radius: 6px;
                        border-width: !root.quit-confirmed ? 3px : 0px;
                        border-color: #e1f9ff;

                        Text {
                            text: "Back";
                            color: #ffffff;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        back-touch := TouchArea {
                            clicked => { root.showing-quit-confirmation = false; }
                        }
                    }
                }
            }
        }
    }

    if root.showing-launch-message : Rectangle {
        background: #000000a8;

        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(520px, parent.width - 48px);
            height: 230px;
            background: #14233b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #58708f;

            VerticalLayout {
                padding: 28px;
                spacing: 16px;
                alignment: center;

                Text {
                    text: "Launching";
                    color: #c5d5e9;
                    font-size: 24px;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.launching-app-name;
                    color: #ffffff;
                    font-size: 30px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}